{
  "name": "three-tier-continuous-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lecturers turn their own notes into timed continuous-assessment quizzes; students sit them free on their phones; results in seconds.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:slow": "SLOW=1 node --test tests/*.test.mjs",
    "dev": "node tools/dev-server.mjs",
    "smoke:mobile": "node tools/mobile-smoke.mjs",
    "test:local": "node --test tests/local/*.test.mjs",
    "smoke:flow": "node tools/browser-flow.mjs",
    "vendor": "node tools/vendor.mjs",
    "domains": "node tools/update-domains.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  },
  "devDependencies": {
    "katex": "0.19.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "sql.js": "1.15.0",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true
  }
}
